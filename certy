#!/usr/bin/env bash
# certy - free SSL (Let's Encrypt) for cPanel accounts, powered by certbot.
#
#   certy -d example.com --wildcard
#   certy -d example.com -d www.example.com -d shop.example.com
#
# Validation is always DNS-01. On cPanel the TXT records are created and
# removed automatically through `uapi`; elsewhere (or with --manual) certy
# prints them in a table and waits for you to add them.
set -euo pipefail

CERTY_VERSION="1.1.0"
CERTY_REPO="${CERTY_REPO:-s7net/certy}"
CERTY_HOME="${CERTY_HOME:-$HOME/.certy}"
CONFIG_DIR="$CERTY_HOME/config"
WORK_DIR="$CERTY_HOME/work"
LOGS_DIR="$CERTY_HOME/logs"
STATE_DIR="$CERTY_HOME/state"
SETTINGS="$CERTY_HOME/settings"
DNS_TIMEOUT="${CERTY_DNS_TIMEOUT:-300}"

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

if { : >/dev/tty; } 2>/dev/null; then
  B=$'\e[1m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; C=$'\e[36m'; N=$'\e[0m'
else
  B=; G=; Y=; R=; C=; N=
fi

# Hooks run under certbot, which swallows their stdout; talk to the terminal
# directly when there is one, otherwise to stderr (ends up in certbot's log).
out() {
  if { : >/dev/tty; } 2>/dev/null; then printf '%s\n' "$*" >/dev/tty; else printf '%s\n' "$*" >&2; fi
}
info() { out "${C}==>${N} $*"; }
ok()   { out "${G}✔${N} $*"; }
warn() { out "${Y}!${N} $*"; }
die()  { out "${R}✘ $*${N}"; exit 1; }

usage() {
  cat <<EOF
${B}certy${N} $CERTY_VERSION - free SSL for cPanel (Let's Encrypt, DNS validation)

  certy                          interactive: new SSL or manage existing
  certy -d example.com [-w]      issue (-w adds *.example.com)
  certy list                     list certificates
  certy renew [NAME]             renew due certificates (cron does this daily)
  certy show|install|delete NAME show files / install on cPanel / delete
  certy update                   update certy and certbot

Options: -d DOMAIN (repeat or comma separated)  -w|--wildcard  -e EMAIL
         --manual (add DNS record yourself)  --no-install  --staging  --force
EOF
}

find_certbot() {
  local c
  for c in "$HOME/bin/certbot" "$CERTY_HOME/certbot/certbot" "$CERTY_HOME/venv/bin/certbot"; do
    [ -x "$c" ] && { echo "$c"; return; }
  done
  command -v certbot 2>/dev/null || die "certbot not found. Re-run the certy installer."
}

run_certbot() {
  mkdir -p "$CONFIG_DIR" "$WORK_DIR" "$LOGS_DIR" "$CERTY_HOME/tmp"
  # Some shared hosts mount /tmp noexec; keep everything in our own dir.
  TMPDIR="$CERTY_HOME/tmp" "$(find_certbot)" \
    --config-dir "$CONFIG_DIR" --work-dir "$WORK_DIR" --logs-dir "$LOGS_DIR" "$@"
}

has_uapi() { command -v uapi >/dev/null 2>&1; }

# ---------------------------------------------------------------- cPanel API
# Small Perl helper (perl + JSON::PP ship with every cPanel server) that
# talks to `uapi` and parses its JSON output.
cpanel() {
  perl -MJSON::PP -MMIME::Base64 -e '
use strict; use warnings;
sub enc { my $s = shift; $s =~ s/([^A-Za-z0-9\-_.~])/sprintf("%%%02X", ord $1)/ge; $s }
sub api {
  my ($mod, $fn, @args) = @_;
  open(my $fh, "-|", "uapi", "--output=json", $mod, $fn, @args) or die "uapi: $!\n";
  local $/; my $raw = <$fh>; close $fh;
  my $j = eval { decode_json($raw) } or die "uapi $mod $fn: bad response\n";
  my $r = $j->{result} // $j;
  return $r;
}
sub errs { my $r = shift; join("; ", @{ $r->{errors} || [] }) || "unknown error" }
sub zone_of {
  my $name = shift; my @l = split /\./, $name;
  while (@l >= 2) {
    my $z = join ".", @l; my $r = api("DNS", "parse_zone", "zone=$z");
    return ($z, $r) if $r->{status};
    shift @l;
  }
  die "no DNS zone for $name in this cPanel account\n";
}
sub serial {
  my $r = shift;
  for my $rec (@{ $r->{data} }) {
    next unless ($rec->{record_type} // "") eq "SOA";
    return decode_base64($rec->{data_b64}[2]);
  }
  die "SOA serial not found\n";
}
sub rel { my ($fqdn, $z) = @_; $fqdn =~ s/\.?\Q$z\E\.?$//; $fqdn eq "" ? "\@" : $fqdn }

my $cmd = shift // "";
if ($cmd eq "zone") {
  my ($z) = zone_of($ARGV[0]); print "$z\n";
}
elsif ($cmd eq "txt-add") {
  my ($fqdn, $val) = @ARGV; my ($z, $r) = zone_of($fqdn);
  my $add = encode_json({ dname => rel($fqdn, $z), ttl => 60, record_type => "TXT", data => [$val] });
  my $res = api("DNS", "mass_edit_zone", "zone=$z", "serial=" . serial($r), "add=$add");
  die errs($res) . "\n" unless $res->{status};
  print "$z\n";
}
elsif ($cmd eq "txt-del") {
  my ($fqdn, $val) = @ARGV; my ($z, $r) = zone_of($fqdn);
  my $want = rel($fqdn, $z); my @rm;
  for my $rec (@{ $r->{data} }) {
    next unless ($rec->{record_type} // "") eq "TXT";
    my $d = decode_base64($rec->{dname_b64} // ""); $d = rel($d, $z);
    my $v = join "", map { decode_base64($_) } @{ $rec->{data_b64} || [] };
    push @rm, "remove=$rec->{line_index}" if $d eq $want && $v eq $val;
  }
  exit 0 unless @rm;
  my $res = api("DNS", "mass_edit_zone", "zone=$z", "serial=" . serial($r), @rm);
  die errs($res) . "\n" unless $res->{status};
}
elsif ($cmd eq "domains") {
  my $d = api("DomainInfo", "list_domains")->{data} || {};
  print "$_\n" for grep { defined && length } $d->{main_domain},
    @{ $d->{addon_domains} || [] }, @{ $d->{sub_domains} || [] }, @{ $d->{parked_domains} || [] };
}
elsif ($cmd eq "install") {
  my ($dom, $cf, $kf, $chf) = @ARGV;
  my $slurp = sub { open my $f, "<", $_[0] or die "$_[0]: $!\n"; local $/; <$f> };
  my $res = api("SSL", "install_ssl", "domain=$dom", "cert=" . enc($slurp->($cf)),
                "key=" . enc($slurp->($kf)), "cabundle=" . enc($slurp->($chf)));
  die errs($res) . "\n" unless $res->{status};
}
else { die "unknown helper command $cmd\n" }
' "$@"
}

# ---------------------------------------------------------------- DNS table
# Draws a box table. Arguments: "col1|col2|..." rows; the first row is the header.
table() {
  local -a rows=("$@") w=() cells
  local row i line sep
  for row in "${rows[@]}"; do
    IFS='|' read -r -a cells <<<"$row"
    for i in "${!cells[@]}"; do
      [ "${#cells[$i]}" -gt "${w[$i]:-0}" ] && w[$i]=${#cells[$i]}
    done
  done
  hline() {
    line="$1"
    for i in "${!w[@]}"; do
      line+="$(printf '─%.0s' $(seq 1 $((w[i] + 2))))"
      [ "$i" -lt $((${#w[@]} - 1)) ] && line+="$2"
    done
    out "$line$3"
  }
  hline "┌" "┬" "┐"
  local first=1
  for row in "${rows[@]}"; do
    IFS='|' read -r -a cells <<<"$row"
    line="│"
    for i in "${!w[@]}"; do
      if [ "$first" = 1 ]; then line+=" ${B}$(printf "%-${w[$i]}s" "${cells[$i]:-}")${N} │"
      else line+=" $(printf "%-${w[$i]}s" "${cells[$i]:-}") │"; fi
    done
    out "$line"
    [ "$first" = 1 ] && hline "├" "┼" "┤"
    first=0
  done
  hline "└" "┴" "┘"
}

# NS records of a name (empty unless it's a zone apex). dig first, DoH if
# dig is missing or port 53 is blocked.
ns_of() {
  local out
  if command -v dig >/dev/null 2>&1 && out="$(dig +time=3 +tries=1 +short NS "$1" 2>/dev/null)"; then
    printf '%s\n' "$out" | grep '\.$' || true
    return
  fi
  curl -fsS -m 10 "https://dns.google/resolve?name=$1&type=NS" 2>/dev/null |
    grep -o '"type": *2,"TTL": *[0-9]*,"data": *"[^"]*"' | sed -e 's/.*"data": *"//' -e 's/"$//' || true
}

# Prints "<zone> <ns> <ns>..." for the zone a name lives in.
zone_info() {
  local d="$1" ns
  while [ "${d#*.}" != "$d" ]; do
    ns="$(ns_of "$d")"
    [ -n "$ns" ] && { echo "$d" $ns; return; }
    d="${d#*.}"
  done
}

# Nameservers that are authoritative for a name.
auth_servers() { zone_info "$1" | cut -d' ' -f2-; }

# Shows where the zone's DNS is hosted (one line), with a Cloudflare link.
print_dns_hosts() {
  local f="$1" name value method info zone ns seen=" "
  while IFS=$'\t' read -r name value method; do
    [ "$method" = manual ] || continue
    info="$(zone_info "$name")"
    [ -n "$info" ] || continue
    zone="${info%% *}"; ns="${info#* }"
    case "$seen" in *" $zone "*) continue ;; esac
    seen="$seen$zone "
    case "$ns" in
      *.cloudflare.com.*) out "Cloudflare: ${C}https://dash.cloudflare.com/?to=/:account/$zone/dns/records${N}" ;;
      *) out "DNS for $zone is at: $(printf '%s\n' $ns | sort | head -n 2 | sed 's/\.$//' | paste -sd, - | sed 's/,/, /g')" ;;
    esac
  done <"$f"
  return 0
}

# Returns 0 when the TXT value is published. Asks the authoritative
# nameservers with dig; if they can't be reached (port 53 blocked, no dig)
# falls back to public DNS-over-HTTPS.
txt_visible() {
  local name="$1" value="$2" ns servers answer reached=0
  if command -v dig >/dev/null 2>&1; then
    servers="$(auth_servers "$name")"
    for ns in $servers; do
      answer="$(dig +time=3 +tries=1 +short TXT "$name" "@$ns" 2>/dev/null)" || continue
      reached=1
      printf '%s\n' "$answer" | tr -d '"' | grep -qxF -- "$value" || return 1
    done
    [ "$reached" = 1 ] && return 0
  fi
  for ns in "https://dns.google/resolve" "https://cloudflare-dns.com/dns-query"; do
    curl -fsS -m 10 -H 'accept: application/dns-json' "$ns?name=$name&type=TXT" 2>/dev/null |
      grep -o '"data": *"[^}]*"' | sed -e 's/^"data": *"//' -e 's/"$//' -e 's/\\"//g' |
      grep -qxF -- "$value" || return 1
  done
}

# Records file: one "name<TAB>value<TAB>method" line per challenge, where
# method is "cpanel" (added through uapi) or "manual" (user adds it).
print_records() {
  local f="$1" check="${2:-}" name value method status
  local -a rows
  if [ -n "$check" ]; then rows=("Name|Type|Value|Status"); else rows=("Name|Type|Value"); fi
  while IFS=$'\t' read -r name value method; do
    if [ -n "$check" ]; then
      if txt_visible "$name" "$value"; then status="OK"; else status="NOT FOUND"; fi
      rows+=("$name|TXT|$value|$status")
    else
      rows+=("$name|TXT|$value")
    fi
  done <"$f"
  table "${rows[@]}"
}

all_visible() {
  local f="$1" name value method
  while IFS=$'\t' read -r name value method; do
    txt_visible "$name" "$value" || return 1
  done <"$f"
}

# Automatic records: poll until they are published or we time out.
wait_for_dns() {
  local f="$1" deadline=$(( $(date +%s) + DNS_TIMEOUT ))
  out "Waiting for DNS..."
  until all_visible "$f"; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      warn "DNS not visible yet; trying anyway"
      return
    fi
    sleep 10
  done
  sleep 5
}

# Manual records: wait for DONE, verify, repeat until everything checks out.
wait_for_done() {
  local f="$1" ans
  { : </dev/tty; } 2>/dev/null || die "Manual DNS needs an interactive terminal"
  while :; do
    printf '%s' "Type ${B}DONE${N} when the record is set (ABORT to cancel): " >/dev/tty
    read -r ans </dev/tty || die "Aborted"
    ans="$(printf '%s' "$ans" | tr 'a-z' 'A-Z' | tr -d '[:space:]')"
    case "$ans" in
      DONE) ;;
      ABORT|EXIT|QUIT) touch "$STATE_DIR/aborted"; die "Cancelled" ;;
      *) continue ;;
    esac
    if all_visible "$f"; then
      ok "DNS record found"
      sleep 5
      return
    fi
    print_records "$f" check
    warn "Not found yet - check the name/value or wait a minute, then type DONE again."
  done
}

# ---------------------------------------------------------------- hooks
# Certbot calls these with CERTBOT_DOMAIN / CERTBOT_VALIDATION set.
hook_auth() {
  local name="_acme-challenge.${CERTBOT_DOMAIN#\*.}" value="$CERTBOT_VALIDATION"
  local f="$STATE_DIR/records" mode method=manual
  mode="$(cat "$STATE_DIR/mode" 2>/dev/null || echo auto)"
  mkdir -p "$STATE_DIR"
  # Use cPanel when it hosts the zone; otherwise fall back to manual.
  if [ "$mode" = auto ] && cpanel txt-add "$name" "$value" >/dev/null 2>&1; then
    method=cpanel
  fi
  printf '%s\t%s\t%s\n' "$name" "$value" "$method" >>"$f"

  # Certbot runs the hook once per challenge; act once all are queued.
  [ "${CERTBOT_REMAINING_CHALLENGES:-0}" = 0 ] || return 0
  if grep -q $'\tmanual$' "$f"; then
    out "Add this TXT record to your DNS:"
    print_records "$f"
    print_dns_hosts "$f"
    wait_for_done "$f"
  else
    ok "DNS record added in cPanel"
    wait_for_dns "$f"
  fi
}

hook_cleanup() {
  local name="_acme-challenge.${CERTBOT_DOMAIN#\*.}" f="$STATE_DIR/records"
  if grep -qF "$name"$'\t'"$CERTBOT_VALIDATION"$'\tcpanel' "$f" 2>/dev/null; then
    cpanel txt-del "$name" "$CERTBOT_VALIDATION" >/dev/null 2>&1 || true
  fi
  [ "${CERTBOT_REMAINING_CHALLENGES:-0}" = 0 ] && rm -f "$f"
  return 0
}

# Install a lineage into every cPanel domain it covers.
install_cert() {
  local lineage="$1" domains="$2" d c installed=""
  has_uapi || return 0
  [ -f "$lineage/cert.pem" ] || return 0
  while read -r d; do
    [ -n "$d" ] || continue
    for c in $domains; do
      if [ "$c" = "$d" ] || { [ "${c#\*.}" != "$c" ] && [ "${d#*.}" = "${c#\*.}" ]; }; then
        if cpanel install "$d" "$lineage/cert.pem" "$lineage/privkey.pem" "$lineage/chain.pem" 2>/dev/null; then
          installed="$installed${installed:+, }$d"
        else
          warn "Could not install on $d"
        fi
        break
      fi
    done
  done <<EOF_DOMAINS
$(cpanel domains)
EOF_DOMAINS
  [ -n "$installed" ] && ok "Installed on cPanel: $installed"
  return 0
}

hook_deploy() {
  [ -f "$STATE_DIR/no-install" ] && return 0
  install_cert "$RENEWED_LINEAGE" "$RENEWED_DOMAINS"
}

# ---------------------------------------------------------------- certificates
cert_names() {
  local d
  for d in "$CONFIG_DIR"/live/*/; do
    [ -f "$d/cert.pem" ] && basename "$d"
  done
  return 0
}

cert_domains() {
  openssl x509 -in "$CONFIG_DIR/live/$1/cert.pem" -noout -text 2>/dev/null |
    grep -o 'DNS:[^,[:space:]]*' | sed 's/^DNS://' | paste -sd' ' -
}

# Prints "YYYY-MM-DD <days left>" for a certificate.
cert_expiry() {
  local end
  end="$(openssl x509 -in "$CONFIG_DIR/live/$1/cert.pem" -noout -enddate 2>/dev/null | sed 's/^notAfter=//; s/ GMT$//')"
  perl -MTime::Piece -e '
    my $t = Time::Piece->strptime($ARGV[0], "%b %d %H:%M:%S %Y");
    printf "%s %d\n", $t->ymd, int(($t->epoch - time) / 86400);' "$end" 2>/dev/null || echo "? ?"
}

# Runs certbot with its chatter hidden; shows only the useful part on failure.
certbot_quiet() {
  local log="$CERTY_HOME/tmp/last-run.log"
  mkdir -p "$CERTY_HOME/tmp"
  if run_certbot "$@" >"$log" 2>&1; then return 0; fi
  [ -f "$STATE_DIR/aborted" ] && return 1
  if grep -q 'Detail:' "$log"; then
    grep 'Detail:' "$log" | sed 's/^[[:space:]]*Detail:[[:space:]]*//' | awk '!seen[$0]++'
  else
    grep -vE '^(Saving debug log|Ask for help|See the logfile)|^[[:space:]]*$' "$log" | head -n 8
  fi | while IFS= read -r l; do out "  $l"; done
  return 1
}

# ---------------------------------------------------------------- commands
install_cron() {
  command -v crontab >/dev/null 2>&1 || return 0
  local line="$((RANDOM % 60)) 3 * * * \"$SELF\" renew >>\"$LOGS_DIR/cron.log\" 2>&1"
  crontab -l 2>/dev/null | grep -qF "$SELF\" renew" && return 0
  { crontab -l 2>/dev/null; echo "$line"; } | crontab - 2>/dev/null || true
}

cmd_issue() {
  local -a domains=()
  local wildcard=0 email="" manual=0 no_install=0 staging=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -d|--domain) [ $# -ge 2 ] || die "$1 needs a value"; IFS=', ' read -r -a _d <<<"$2"; domains+=("${_d[@]}"); shift ;;
      --domain=*) IFS=', ' read -r -a _d <<<"${1#*=}"; domains+=("${_d[@]}") ;;
      -w|--wildcard) wildcard=1 ;;
      -e|--email) [ $# -ge 2 ] || die "$1 needs a value"; email="$2"; shift ;;
      --email=*) email="${1#*=}" ;;
      --manual) manual=1 ;;
      --no-install) no_install=1 ;;
      --staging) staging=1 ;;
      --force) force=1 ;;
      -h|--help) usage; exit 0 ;;
      *) die "Unknown option: $1 (see certy help)" ;;
    esac
    shift
  done
  [ ${#domains[@]} -gt 0 ] || { usage; exit 1; }

  # Normalise: strip scheme/path/spaces, lowercase, de-duplicate.
  local -a list=() ; local d
  for d in "${domains[@]}"; do
    d="$(printf '%s' "$d" | tr 'A-Z' 'a-z' | sed -e 's#^[a-z]*://##' -e 's#/.*##' -e 's/[[:space:]]//g')"
    [ -n "$d" ] || continue
    list+=("$d")
    [ "$wildcard" = 1 ] && [ "${d#\*.}" = "$d" ] && list+=("*.$d")
  done
  local -a uniq=()
  for d in "${list[@]}"; do
    case " ${uniq[*]:-} " in *" $d "*) ;; *) uniq+=("$d") ;; esac
  done
  [ ${#uniq[@]} -gt 0 ] || die "No valid domain given"

  mkdir -p "$CERTY_HOME" "$STATE_DIR"
  [ -n "$email" ] && echo "EMAIL=$email" >"$SETTINGS"
  [ -z "$email" ] && [ -f "$SETTINGS" ] && email="$(sed -n 's/^EMAIL=//p' "$SETTINGS")"

  has_uapi || manual=1
  [ "$manual" = 1 ] && echo manual >"$STATE_DIR/mode" || echo auto >"$STATE_DIR/mode"
  [ "$no_install" = 1 ] && touch "$STATE_DIR/no-install" || rm -f "$STATE_DIR/no-install"
  rm -f "$STATE_DIR/records" "$STATE_DIR/aborted"

  local name="${uniq[0]#\*.}"
  out "Requesting SSL for ${B}${uniq[*]}${N}"

  local -a args=(certonly --non-interactive --agree-tos --cert-name "$name"
    --manual --preferred-challenges dns
    --manual-auth-hook "$SELF __hook-auth"
    --manual-cleanup-hook "$SELF __hook-cleanup"
    --deploy-hook "$SELF __hook-deploy"
    --expand)
  for d in "${uniq[@]}"; do args+=(-d "$d"); done
  if [ -n "$email" ]; then args+=(-m "$email"); else args+=(--register-unsafely-without-email); fi
  [ "$staging" = 1 ] && args+=(--staging)
  [ "$force" = 1 ] && args+=(--force-renewal)

  if ! certbot_quiet "${args[@]}"; then
    [ -f "$STATE_DIR/aborted" ] && { rm -f "$STATE_DIR/aborted"; exit 1; }
    die "Failed. Full log: $LOGS_DIR/letsencrypt.log"
  fi

  local exp; exp="$(cert_expiry "$name")"
  ok "SSL ready for ${B}$name${N} (expires ${exp%% *})"
  out "   Files: $CONFIG_DIR/live/$name/"
  install_cron
}

cmd_renew() {
  rm -f "$STATE_DIR/records"
  # Each renewal keeps the hooks it was issued with; mode defaults to auto.
  [ -f "$STATE_DIR/mode" ] || echo auto >"$STATE_DIR/mode"
  if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    local n="$1"; shift
    set -- --cert-name "$n" "$@"
  fi
  run_certbot renew --non-interactive "$@"
}

cmd_list() {
  local -a rows=("#|Name|Domains|Expires|Days left") names=()
  local n i=0 exp
  while read -r n; do [ -n "$n" ] && names+=("$n"); done <<EOF_NAMES
$(cert_names)
EOF_NAMES
  [ ${#names[@]} -gt 0 ] || { out "No certificates yet. Run: certy"; return 1; }
  for n in "${names[@]}"; do
    i=$((i + 1)); exp="$(cert_expiry "$n")"
    rows+=("$i|$n|$(cert_domains "$n")|${exp%% *}|${exp##* }")
  done
  table "${rows[@]}"
}

cmd_show() {
  local live="$CONFIG_DIR/live/$1"
  [ -f "$live/cert.pem" ] || die "No certificate named $1"
  out "$live/"
  out "  cert.pem       certificate"
  out "  privkey.pem    private key"
  out "  chain.pem      CA bundle"
  out "  fullchain.pem  certificate + CA bundle"
}

cmd_delete() {
  [ -f "$CONFIG_DIR/live/$1/cert.pem" ] || die "No certificate named $1"
  certbot_quiet delete --non-interactive --cert-name "$1" || die "Delete failed"
  ok "Deleted $1"
}

cmd_install() {
  [ -f "$CONFIG_DIR/live/$1/cert.pem" ] || die "No certificate named $1"
  has_uapi || die "cPanel uapi not available"
  install_cert "$CONFIG_DIR/live/$1" "$(cert_domains "$1")"
}

cmd_update() {
  local ref mode=--user
  [ "$SELF" = /usr/local/bin/certy ] && mode=--root
  ref="$(curl -fsSL "https://api.github.com/repos/$CERTY_REPO/commits/main" 2>/dev/null |
    sed -n 's/^  "sha": "\([0-9a-f]\{40\}\)".*/\1/p' | head -n1)"
  curl -fsSL "https://raw.githubusercontent.com/$CERTY_REPO/${ref:-main}/install.sh" | bash -s -- "$mode"
}

# ---------------------------------------------------------------- interactive
banner() {
  out "${C}                 _"
  out "   ___ ___ _ __| |_ _   _"
  out "  / __/ _ \\ '__| __| | | |"
  out " | (_|  __/ |  | |_| |_| |"
  out "  \\___\\___|_|   \\__|\\__, |"
  out "                    |___/${N}  ${B}free SSL for cPanel${N} v$CERTY_VERSION"
  out ""
}

ask() { # prompt [default]
  local a
  printf '%s' "$1" >/dev/tty
  read -r a </dev/tty || a=""
  printf '%s' "${a:-${2:-}}"
}

wizard() {
  local dom wild method
  dom="$(ask "Domain: ")"
  [ -n "$dom" ] || die "No domain given"
  local -a args=(-d "$dom")
  wild="$(ask "Include wildcard (*.${dom%%[ ,]*})? [y/N]: " n)"
  case "$wild" in y|Y|yes) args+=(--wildcard) ;; esac
  if has_uapi; then
    out "Verification:"
    out "  1) Automatic (cPanel DNS)"
    out "  2) Manual (I add the DNS record)"
    method="$(ask "Choose [1]: " 1)"
    [ "$method" = 2 ] && args+=(--manual)
  fi
  out ""
  cmd_issue "${args[@]}"
}

manage() {
  local -a names=()
  local n sel act
  cmd_list || return 0
  while read -r n; do [ -n "$n" ] && names+=("$n"); done <<EOF_NAMES
$(cert_names)
EOF_NAMES
  sel="$(ask "Select # (Enter to exit): ")"
  [ -n "$sel" ] || return 0
  case "$sel" in *[!0-9]*) die "Invalid choice" ;; esac
  [ "$sel" -ge 1 ] && [ "$sel" -le ${#names[@]} ] || die "Invalid choice"
  n="${names[$((sel - 1))]}"
  out "${B}$n${N}"
  out "  1) Renew now"
  out "  2) Install on cPanel"
  out "  3) Show files"
  out "  4) Delete"
  act="$(ask "Choose (Enter to exit): ")"
  case "$act" in
    1) certbot_quiet renew --non-interactive --cert-name "$n" --force-renewal && ok "Renewed $n" || die "Renew failed" ;;
    2) cmd_install "$n" ;;
    3) cmd_show "$n" ;;
    4) [ "$(ask "Delete $n? Type yes to confirm: ")" = yes ] && cmd_delete "$n" ;;
    *) ;;
  esac
}

interactive() {
  { : </dev/tty; } 2>/dev/null || { usage; exit 0; }
  banner
  if [ -z "$(cert_names)" ]; then wizard; return; fi
  out "  1) New SSL"
  out "  2) Manage SSLs"
  case "$(ask "Choose [1]: " 1)" in
    2) manage ;;
    *) out ""; wizard ;;
  esac
}

case "${1:-}" in
  "") interactive ;;
  -h|--help|help) usage ;;
  version|-v|--version) echo "certy $CERTY_VERSION"; "$(find_certbot)" --version 2>/dev/null || true ;;
  renew) shift; cmd_renew "$@" ;;
  list|ls) cmd_list || true ;;
  show) [ $# -ge 2 ] || die "Usage: certy show NAME"; cmd_show "$2" ;;
  delete|rm) [ $# -ge 2 ] || die "Usage: certy delete NAME"; cmd_delete "$2" ;;
  install) [ $# -ge 2 ] || die "Usage: certy install NAME"; cmd_install "$2" ;;
  manage) manage ;;
  cron) install_cron; ok "Auto-renew enabled" ;;
  uninstall-cron) crontab -l 2>/dev/null | grep -vF "$SELF\" renew" | crontab - ; ok "Auto-renew disabled" ;;
  update) cmd_update ;;
  __hook-auth) hook_auth ;;
  __hook-cleanup) hook_cleanup ;;
  __hook-deploy) hook_deploy ;;
  *) cmd_issue "$@" ;;
esac
